# Core Agents
DATABASE_URL=postgres://orchestream_ai:orchestream_ai@localhost:5432/orchestream_ai
PORT=3001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required. JWT signing key — must be a random string of at least 32 characters.
# The backend refuses to start in production with a missing/weak/default value.
JWT_SECRET=
# Required by the worker and sidecar for the code-execution sandbox.
# Must match between the two services; keep it secret in production.
SIDECAR_TOKEN=dev-sidecar-token-change-me
VALKEY_PASSWORD=dev-valkey
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000

# SSO / OIDC (optional — uncomment to enable SSO login)
# AUTH_SSO_PROVIDER=keycloak
# AUTH_SSO_CLIENT_ID=your-client-id
# AUTH_SSO_CLIENT_SECRET=your-client-secret
# AUTH_SSO_ISSUER=https://keycloak.example.com/realms/your-realm
# AUTH_SSO_REDIRECT_URI=http://localhost:3001/api/auth/sso/callback
# AUTH_ADMIN_GROUPS=orchestream-ai-admin
# AUTH_EDITOR_GROUPS=orchestream-ai-editor
